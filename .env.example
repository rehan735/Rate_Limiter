# =============================================================================
# Distributed Rate Limiter & API Gateway — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env.
# =============================================================================

# --- Application ---
APP_ENV=development          # development | production
LOG_LEVEL=info               # debug | info | warn | error
LOG_FORMAT=json              # json | text

# --- Gateway Server ---
GATEWAY_HTTP_PORT=8080
GATEWAY_METRICS_PORT=9090
GATEWAY_READ_TIMEOUT=30s
GATEWAY_WRITE_TIMEOUT=30s
GATEWAY_IDLE_TIMEOUT=120s
GATEWAY_MAX_REQUEST_SIZE=10485760   # 10 MB
GATEWAY_SHUTDOWN_TIMEOUT=30s
GATEWAY_MAX_CONCURRENT_REQUESTS=10000
# Comma-separated exact proxy IPs/CIDRs; empty means forwarded headers are ignored.
GATEWAY_TRUSTED_PROXIES=
# Set exact internal service CIDRs in production when private upstreams are required.
GATEWAY_BACKEND_ALLOWED_CIDRS=

# --- Control Plane Server ---
CONTROL_PLANE_PORT=8081
CONTROL_PLANE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ratelimiter
POSTGRES_USER=ratelimiter
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_LIFETIME=5m

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_RETRIES=3
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
REDIS_POOL_SIZE=20
REDIS_MIN_IDLE_CONNS=5

# Redis failure policy: fail_open | fail_closed | local_fallback
REDIS_FAILURE_POLICY=fail_open

# --- JWT ---
# Generate with: openssl genrsa -out private.pem 2048
JWT_PRIVATE_KEY_PATH=/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/secrets/jwt_public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
JWT_ISSUER=rate-limiter-gateway
JWT_ALLOW_EPHEMERAL=true       # development only; production must mount persistent keys

# --- Admin Bootstrap ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_on_first_login
GRAFANA_PASSWORD=change_me_in_development

# --- Rate Limiting Defaults ---
DEFAULT_RATE_LIMIT_ALGORITHM=token_bucket
DEFAULT_RATE_LIMIT=1000          # requests per minute
DEFAULT_BURST_CAPACITY=100

# --- Tracing ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=api-gateway
OTEL_SERVICE_VERSION=0.1.0

# --- Frontend ---
VITE_API_BASE_URL=
VITE_GATEWAY_URL=/gateway
VITE_DEMO_MODE=false
VITE_SSE_URL=http://localhost:8081/api/v1/events
